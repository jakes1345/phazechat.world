<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone (voice messages + calls) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera (QR scanner + video calls) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Camera is optional: don't let Play filter out camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Calls run in the Jitsi Meet SDK, whose manifest adds what it needs:
         network state, audio settings, Bluetooth, MANAGE_OWN_CALLS, and the
         foreground-service permissions (microphone, media playback, media
         projection) for its ongoing-call service and screen sharing. Don't
         strip those: on Android 14+ the call service can't start without
         FOREGROUND_SERVICE_MICROPHONE. -->

    <!-- Strip permissions that libraries merge in but we don't use directly -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />



    <!-- tools:replace: the Jitsi Meet SDK's manifest sets its own allowBackup
         and label on <application>; ours win. -->
    <application
        tools:replace="android:allowBackup,android:label"
        android:name=".PhazeApp"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:pageSizeCompat="enabled"
        android:icon="@mipmap/ic_launcher"
        android:label="Phaze"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phaze"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="world.phazechat.app.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="phaze" android:host="open" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QRScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.Phaze" />

        <!-- Firebase Cloud Messaging — handles push notification delivery only. -->
        <service
            android:name=".PhazeFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
